rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{collection}/{document=**} {
      // La coda email è gestita esclusivamente dal server con Firebase Admin.
      // Le regole Admin bypassano questa policy, i client autenticati no.
      allow read, write: if request.auth != null && collection != 'notifications_queue';
    }
  }
}
