# Copia in .env.local e compila. Non mettere mai valori reali in questo file:
# .env.local è ignorato da git, questo no.

# Firebase, configurazione web (obbligatoria: senza, la build si ferma)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin, solo in locale: chiave personale di un service account.
# In produzione App Hosting usa le proprie credenziali e queste non servono.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Usata dalle route CRM e prospect per verificare il login
FIREBASE_WEB_API_KEY=

NEXT_PUBLIC_APP_URL=

# Email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
CRM_EMAIL_FROM=
CRON_SECRET=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Calendari
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# AI
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
PROSPECT_AI_MODEL=

NEXT_PUBLIC_JITSI_DOMAIN=
